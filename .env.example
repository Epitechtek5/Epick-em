# Copier en .env (ignoré par git) : cp .env.example .env
# Les valeurs ci-dessous sont sans risque et suffisent pour le développement local.

# Nom de la base PostgreSQL
POSTGRES_DB=epickem
# Utilisateur PostgreSQL
POSTGRES_USER=epickem
# Mot de passe PostgreSQL (local uniquement)
POSTGRES_PASSWORD=epickem
# Port PostgreSQL exposé sur la machine hôte
POSTGRES_PORT=5432
# Port Redis exposé sur la machine hôte
REDIS_PORT=6379

# URL de connexion utilisée par les services Rust
DATABASE_URL=postgres://epickem:epickem@postgres:5432/epickem
# Taille maximale du pool PostgreSQL de chaque service (optionnel, 10 par défaut)
DATABASE_MAX_CONNECTIONS=10
# URL Redis (cache + bus d'événements, voir ADR-002)
REDIS_URL=redis://redis:6379

# Clé de signature des jetons d'accès JWT (32 caractères minimum). Valeur de dev uniquement :
# en production, générer une clé aléatoire (openssl rand -hex 32) et la stocker en secret (ADR-007)
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
# Durée de vie du jeton d'accès, en secondes (optionnel, 900 par défaut)
ACCESS_TOKEN_TTL_SECS=900
# Durée de vie du jeton de rafraîchissement, en secondes (optionnel, 2592000 = 30 jours par défaut)
REFRESH_TOKEN_TTL_SECS=2592000

# Clé d'API Resend pour l'e-mail « mot de passe oublié » (optionnel : sans elle, aucun e-mail
# n'est envoyé). En production, la stocker en secret (ADR-007)
RESEND_API_KEY=
# Expéditeur des e-mails (en production : une adresse d'un domaine vérifié chez Resend)
MAIL_FROM=Epick'em <onboarding@resend.dev>
# Début du lien de réinitialisation envoyé par e-mail ; le jeton s'y ajoute en `?token=`
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Port HTTP/WebSocket de l'API publique
API_PUBLIC_PORT=8080
# Port de l'API interne (non exposé sur l'hôte)
API_INTERNAL_PORT=8081

# Jeton API start.gg (optionnel : les tests utilisent des mocks)
STARTGG_TOKEN=

# Port du front web exposé sur la machine hôte
WEB_PORT=3000

# URL publique de l'API utilisée par l'application Expo (React Native)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "demo": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EPICKEM_BUILD_PROFILE": "demo"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      },
      "env": {
        "EPICKEM_BUILD_PROFILE": "demo"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EPICKEM_BUILD_PROFILE": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

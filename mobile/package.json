{
  "name": "@epickem/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react-native": "^1.0.16",
    "@react-navigation/native": "^7.5.1",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/slot": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "config:check": "expo config --type prebuild",
    "build": "expo export --platform android --platform ios",
    "build:android": "node scripts/build-native.mjs android",
    "build:ios:simulator": "node scripts/build-native.mjs ios",
    "build:ios:device": "node scripts/build-native.mjs ios --device",
    "build:apk": "npm run build:android && mkdir -p binaries && mv android/app/build/outputs/apk/release/app-release.apk binaries/epickem.apk",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm test -- --watch=false && npm run config:check && npm run build",
    "openapi:generate": "node ../openapi/fetch.mjs",
    "openapi:build": "openapi-typescript ../openapi/openapi.json -o src/api/generated/schema.ts"
  },
  "private": true,
  "overrides": {
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    },
    "@istanbuljs/load-nyc-config@1.1.0": {
      "js-yaml": "4.3.2"
    },
    "tailwindcss": {
      "postcss-selector-parser": "7.1.6"
    },
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    },
    "@expo/cli": {
      "zod": "4.6.7"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}

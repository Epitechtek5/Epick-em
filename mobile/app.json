{
  "expo": {
    "name": "Epick’em",
    "slug": "epickem",
    "version": "1.0.0",
    "scheme": "epickem",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.epickem.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.epickem.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
